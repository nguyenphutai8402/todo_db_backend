-- --------------------------------------------------------
-- 1. Cấu hình ban đầu
-- --------------------------------------------------------
SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0; -- Tắt kiểm tra khóa ngoại để tạo bảng không bị lỗi thứ tự

-- --------------------------------------------------------
-- 2. Tạo các bảng (Tables)
-- --------------------------------------------------------

-- Bảng User
DROP TABLE IF EXISTS `users`; -- Đổi tên thành số nhiều 'users' cho chuẩn (hoặc giữ 'user' tùy bạn, ở đây mình giữ user theo đề bài nhưng khuyến khích dùng users)
CREATE TABLE `user` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `email` VARCHAR(255) NOT NULL,
  `password_hash` VARCHAR(255) NOT NULL,
  `full_name` VARCHAR(255) NOT NULL,
  `avatar_url` TEXT,
  `status` VARCHAR(20) NOT NULL DEFAULT 'active',
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_user_email` (`email`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Workspaces
DROP TABLE IF EXISTS `workspaces`;
CREATE TABLE `workspaces` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `name` VARCHAR(150) NOT NULL,
  `description` TEXT,
  `visibility` VARCHAR(20) NOT NULL DEFAULT 'private', -- private, public
  `created_by` BIGINT NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Workspace Members
DROP TABLE IF EXISTS `workspace_members`;
CREATE TABLE `workspace_members` (
  `workspace_id` BIGINT NOT NULL,
  `user_id` BIGINT NOT NULL,
  `role` VARCHAR(20) NOT NULL DEFAULT 'member', -- admin, member
  `joined_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`workspace_id`, `user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Boards
DROP TABLE IF EXISTS `boards`;
CREATE TABLE `boards` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `workspace_id` BIGINT NOT NULL,
  `name` VARCHAR(150) NOT NULL,
  `description` TEXT,
  `visibility` VARCHAR(20) NOT NULL DEFAULT 'workspace', -- private, workspace, public
  `is_archived` BOOLEAN NOT NULL DEFAULT FALSE,
  `created_by` BIGINT NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Board Members
DROP TABLE IF EXISTS `board_members`;
CREATE TABLE `board_members` (
  `board_id` BIGINT NOT NULL,
  `user_id` BIGINT NOT NULL,
  `role` VARCHAR(20) NOT NULL DEFAULT 'member',
  `joined_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`board_id`, `user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Lists
DROP TABLE IF EXISTS `lists`;
CREATE TABLE `lists` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `board_id` BIGINT NOT NULL, -- Đã sửa từ boards_id
  `name` VARCHAR(150) NOT NULL,
  `position` INT NOT NULL DEFAULT 0,
  `is_archived` BOOLEAN NOT NULL DEFAULT FALSE,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Cards
DROP TABLE IF EXISTS `cards`;
CREATE TABLE `cards` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `board_id` BIGINT NOT NULL, -- Đã sửa từ boards_id
  `list_id` BIGINT NOT NULL,
  `title` VARCHAR(200) NOT NULL,
  `description` TEXT,
  `position` INT NOT NULL DEFAULT 0,
  `due_at` TIMESTAMP NULL,
  `start_at` TIMESTAMP NULL,
  `is_archived` BOOLEAN NOT NULL DEFAULT FALSE,
  `created_by` BIGINT NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Card Members
DROP TABLE IF EXISTS `card_members`;
CREATE TABLE `card_members` (
  `card_id` BIGINT NOT NULL,
  `user_id` BIGINT NOT NULL,
  `added_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`card_id`, `user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Labels
DROP TABLE IF EXISTS `labels`;
CREATE TABLE `labels` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `board_id` BIGINT NOT NULL, -- Đã sửa từ boards_id
  `name` VARCHAR(60),
  `color` VARCHAR(30) NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Card Labels
DROP TABLE IF EXISTS `card_labels`;
CREATE TABLE `card_labels` (
  `card_id` BIGINT NOT NULL,
  `label_id` BIGINT NOT NULL,
  PRIMARY KEY (`card_id`, `label_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Checklists
DROP TABLE IF EXISTS `checklists`;
CREATE TABLE `checklists` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `card_id` BIGINT NOT NULL,
  `title` VARCHAR(150) NOT NULL,
  `position` INT NOT NULL DEFAULT 0,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Checklist Items
DROP TABLE IF EXISTS `checklist_items`;
CREATE TABLE `checklist_items` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `checklist_id` BIGINT NOT NULL, -- Đã sửa từ checklists_id
  `content` VARCHAR(300) NOT NULL,
  `is_done` BOOLEAN NOT NULL DEFAULT FALSE,
  `due_at` TIMESTAMP NULL,
  `position` INT NOT NULL DEFAULT 0,
  `completed_at` TIMESTAMP NULL,
  `completed_by` BIGINT,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Card Comments
DROP TABLE IF EXISTS `card_comments`;
CREATE TABLE `card_comments` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `card_id` BIGINT NOT NULL,
  `user_id` BIGINT NOT NULL,
  `content` TEXT NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP NULL ON UPDATE CURRENT_TIMESTAMP,
  `deleted_at` TIMESTAMP NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Card Attachments (Đã sửa tên bảng)
DROP TABLE IF EXISTS `card_attachments`;
CREATE TABLE `card_attachments` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `card_id` BIGINT NOT NULL,
  `uploaded_by` BIGINT NOT NULL,
  `file_name` VARCHAR(255),
  `file_url` TEXT NOT NULL,
  `mime_type` VARCHAR(100), -- Đã sửa từ mine_type
  `size_bytes` BIGINT,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Activities
DROP TABLE IF EXISTS `activities`;
CREATE TABLE `activities` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `board_id` BIGINT NOT NULL,
  `actor_user_id` BIGINT NOT NULL,
  `action` VARCHAR(50) NOT NULL,
  `target_type` VARCHAR(30), -- vd: card, list, comment
  `target_id` BIGINT,
  `data` TEXT, -- JSON data chi tiết
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- Bảng Invites
DROP TABLE IF EXISTS `invites`;
CREATE TABLE `invites` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `workspace_id` BIGINT,
  `board_id` BIGINT,
  `email` VARCHAR(255) NOT NULL,
  `role` VARCHAR(20) NOT NULL DEFAULT 'member',
  `token` VARCHAR(255) NOT NULL,
  `expires_at` TIMESTAMP NOT NULL,
  `accepted_at` TIMESTAMP NULL,
  `created_by` BIGINT NOT NULL,
  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_invite_token` (`token`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- --------------------------------------------------------
-- 3. Tạo Khóa Ngoại (Foreign Keys)
-- --------------------------------------------------------

-- Workspaces
ALTER TABLE `workspaces` 
  ADD CONSTRAINT `fk_workspace_owner` FOREIGN KEY (`created_by`) REFERENCES `user` (`id`);

-- Workspace Members
ALTER TABLE `workspace_members` 
  ADD CONSTRAINT `fk_wm_workspace` FOREIGN KEY (`workspace_id`) REFERENCES `workspaces` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_wm_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`) ON DELETE CASCADE;

-- Boards
ALTER TABLE `boards` 
  ADD CONSTRAINT `fk_board_workspace` FOREIGN KEY (`workspace_id`) REFERENCES `workspaces` (`id`) ON DELETE CASCADE, -- Thêm cascade xóa workspace thì xóa board
  ADD CONSTRAINT `fk_board_owner` FOREIGN KEY (`created_by`) REFERENCES `user` (`id`);

-- Board Members
ALTER TABLE `board_members` 
  ADD CONSTRAINT `fk_bm_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_bm_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`) ON DELETE CASCADE;

-- Lists
ALTER TABLE `lists` 
  ADD CONSTRAINT `fk_list_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE;

-- Cards
ALTER TABLE `cards` 
  ADD CONSTRAINT `fk_card_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_card_list` FOREIGN KEY (`list_id`) REFERENCES `lists` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_card_creator` FOREIGN KEY (`created_by`) REFERENCES `user` (`id`);

-- Card Members
ALTER TABLE `card_members` 
  ADD CONSTRAINT `fk_cm_card` FOREIGN KEY (`card_id`) REFERENCES `cards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_cm_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`) ON DELETE CASCADE;

-- Labels
ALTER TABLE `labels` 
  ADD CONSTRAINT `fk_label_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE;

-- Card Labels
ALTER TABLE `card_labels` 
  ADD CONSTRAINT `fk_cl_card` FOREIGN KEY (`card_id`) REFERENCES `cards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_cl_label` FOREIGN KEY (`label_id`) REFERENCES `labels` (`id`) ON DELETE CASCADE;

-- Checklists
ALTER TABLE `checklists` 
  ADD CONSTRAINT `fk_checklist_card` FOREIGN KEY (`card_id`) REFERENCES `cards` (`id`) ON DELETE CASCADE;

-- Checklist Items
ALTER TABLE `checklist_items` 
  ADD CONSTRAINT `fk_ci_checklist` FOREIGN KEY (`checklist_id`) REFERENCES `checklists` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_ci_completer` FOREIGN KEY (`completed_by`) REFERENCES `user` (`id`);

-- Card Comments
ALTER TABLE `card_comments` 
  ADD CONSTRAINT `fk_comment_card` FOREIGN KEY (`card_id`) REFERENCES `cards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_comment_user` FOREIGN KEY (`user_id`) REFERENCES `user` (`id`);

-- Card Attachments
ALTER TABLE `card_attachments` 
  ADD CONSTRAINT `fk_attachment_card` FOREIGN KEY (`card_id`) REFERENCES `cards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_attachment_uploader` FOREIGN KEY (`uploaded_by`) REFERENCES `user` (`id`);

-- Activities
ALTER TABLE `activities` 
  ADD CONSTRAINT `fk_activity_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_activity_actor` FOREIGN KEY (`actor_user_id`) REFERENCES `user` (`id`);

-- Invites
ALTER TABLE `invites` 
  ADD CONSTRAINT `fk_invite_workspace` FOREIGN KEY (`workspace_id`) REFERENCES `workspaces` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_invite_board` FOREIGN KEY (`board_id`) REFERENCES `boards` (`id`) ON DELETE CASCADE,
  ADD CONSTRAINT `fk_invite_creator` FOREIGN KEY (`created_by`) REFERENCES `user` (`id`);

-- Bật lại kiểm tra khóa ngoại
SET FOREIGN_KEY_CHECKS = 1;
